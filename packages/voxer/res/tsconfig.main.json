// this configurations file will be locate into .voxer
// and extended by src/tsconfig.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "paths": {
      "#voxer": ["../.voxer/runtime/index"],
      "#voxer/*": ["../.voxer/runtime/*"],
      "~": ["./"],
      "~/*": ["./*"]
    }
  },
  "include": ["./runtime/**/*", "../src/**/*", "../voxer.config.ts"],
  "exclude": ["./runtime/preload.js", "../src/preload.*", "../src/preload/**/*"]
}
