// this configurations file will be locate into .voxer
// and extended by src/tsconfig.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../src"
  },
  "include": ["../src/**/*"],
  "exclude": ["../src/preload.ts"]
}
