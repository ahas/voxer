{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": "src",
    "rootDir": "src",
    "outDir": "./.types-temp",
    "stripInternal": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "inlineSourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["**/__test__.ts"]
}
